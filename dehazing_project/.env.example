# Local development uses SQLite. Set USE_POSTGRES=1 only for a configured PostgreSQL server.
# Local development uses SQLite. Set USE_POSTGRES=1 only for a configured PostgreSQL server.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_SECURE_SSL=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
USE_POSTGRES=0
DATABASE_URL=
POSTGRES_SSLMODE=prefer

